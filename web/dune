; The web UI is compiled to JavaScript by js_of_ocaml.
; [modes js] makes dune build web/main.bc.js instead of a native binary.

(executable
 (name main)
 (modes js)
 (libraries
  core
  yojson
  async_js
  js_of_ocaml
  bonsai
  bonsai.web
  virtual_dom
  virtual_dom.svg
  fade_types)
 (preprocess
  (pps ppx_jane bonsai.ppx_bonsai js_of_ocaml-ppx)))
