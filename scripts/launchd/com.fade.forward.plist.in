<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for `make forward-install`, which fills in @REPO@ and @PATH@ and writes
     ~/Library/LaunchAgents/com.fade.forward.plist. Runs the forward test daily at
     06:30 local time; launchd runs a missed job when the Mac wakes. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fade.forward</string>
  <key>ProgramArguments</key>
  <array>
    <string>@REPO@/scripts/forward-job.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@REPO@</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>@REPO@/logs/forward.log</string>
  <key>StandardErrorPath</key>
  <string>@REPO@/logs/forward.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
  </dict>
</dict>
</plist>
